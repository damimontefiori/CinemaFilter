# Configuración de Autenticación de CinemaFilter
# Claves de acceso autorizadas separadas por comas
# Si el usuario ingresa cualquiera de estas claves, se le permite el acceso.
APP_PASSWORDS=clave1,clave2,amigo123

# Clave secreta para firmar las cookies de sesión de Flask (cambiar por una cadena aleatoria)
FLASK_SECRET_KEY=cambiar_por_una_cadena_secreta_y_aleatoria_2026
